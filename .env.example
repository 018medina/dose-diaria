# Gere com: npm run vapid
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Seu e-mail no formato mailto:
VAPID_SUBJECT=mailto:seu-email@exemplo.com

# Senha longa e aleatória; a mesma vai no cabeçalho do cron-job.org
CRON_SECRET=

# Criadas automaticamente pela integração Upstash da Vercel
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
